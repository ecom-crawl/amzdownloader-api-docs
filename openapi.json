    "/scrapes": {
      "post": {
        "operationId": "createScrape",
        "summary": "Extract product media",
        "description": "Extract product images, variant images, and videos. Returns a cached result or an asynchronous job. Costs 1 credit on success, including cache hits. Polling is free. Use an idempotency key for retries.",
        "tags": [
          "Extraction"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$",
              "description": "Reuse for retries of the same request. Replays do not consume additional credits."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048,
                    "description": "HTTPS Amazon product URL containing an ASIN."
                  },
                  "include": {
                    "type": "object",
                    "properties": {
                      "productImages": {
                        "type": "boolean",
                        "default": true
                      },
                      "variantImages": {
                        "type": "boolean",
                        "default": true
                      },
                      "productVideos": {
                        "type": "boolean",
                        "default": true
                      },
                      "relatedVideos": {
                        "type": "boolean",
                        "default": true
                      },
                      "creatorVideos": {
                        "type": "boolean",
                        "default": true
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  },
                  "renderMode": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "static",
                      "interactive"
                    ],
                    "default": "auto"
                  },
                  "refresh": {
                    "type": "boolean",
                    "default": false,
                    "description": "Request fresh extraction instead of an available cached result."
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cached completed result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaResponse"
                }
              }
            }
          },
          "202": {
            "description": "Extraction queued or processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource unavailable to this account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict or request still running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Job expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Amazon extraction could not be completed; reserved credits released",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate or concurrency limit exceeded; retry after the indicated delay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Extraction or conversion service failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable; retry after the indicated delay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
