    "/videos/convert": {
      "post": {
        "operationId": "convertVideo",
        "summary": "Convert Amazon video",
        "description": "Convert an Amazon media HLS URL into an MP4 URL. Costs 1 credit on success, including cached conversion results. Use an idempotency key for retries.",
        "tags": [
          "Media"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$",
              "description": "Reuse for retries of the same request. Replays do not consume additional credits."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 4096,
                    "description": "Amazon media HTTPS URL ending in .m3u8."
                  },
                  "country": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{2}$",
                    "description": "Optional two-letter country code."
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Converted MP4 URL",
