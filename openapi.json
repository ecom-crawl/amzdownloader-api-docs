    "/products/{asin}/media": {
      "get": {
        "operationId": "getProductMedia",
        "summary": "Get cached product media",
        "description": "Read cached product media without starting extraction. Costs 1 credit on success. Use create scrape to refresh.",
        "tags": [
          "Media"
        ],
        "parameters": [
          {
            "name": "asin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{10}$"
            }
          },
          {
            "name": "marketplace",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "amazon.com",
                "amazon.ca",
                "amazon.com.mx",
                "amazon.com.br",
                "amazon.co.uk",
                "amazon.de",
                "amazon.fr",
                "amazon.it",
                "amazon.es",
                "amazon.nl",
                "amazon.se",
                "amazon.pl",
                "amazon.com.be",
                "amazon.ie",
                "amazon.co.jp",
                "amazon.in",
                "amazon.com.au",
                "amazon.sg",
                "amazon.ae",
                "amazon.sa",
                "amazon.com.tr",
                "amazon.eg",
                "amazon.co.za"
              ],
              "default": "amazon.com"
            }
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated groups: productImages, variantImages, productVideos, relatedVideos, creatorVideos. Defaults to all groups."
            }
          },
          {
            "name": "renderMode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "auto",
                "static",
                "interactive"
              ],
              "default": "auto"
            }
          },
          {
            "name": "Idempotency-Key",
