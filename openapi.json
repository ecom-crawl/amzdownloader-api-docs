{
  "openapi": "3.1.0",
  "info": {
    "title": "AMZ Downloader API",
    "version": "1.0.0",
    "description": "Extract Amazon product media, inspect asynchronous jobs, and convert Amazon HLS video. REST and MCP share customer accounts and credits. Successful media retrievals and conversions each cost 1 credit; polling, failures, and idempotent replays are free."
  },
  "servers": [
    {
      "url": "https://amzdownloader.com/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Discovery"
    },
    {
      "name": "Extraction"
    },
    {
      "name": "Media"
    },
    {
      "name": "Account"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service health",
        "tags": [
          "Discovery"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Gateway is available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/capabilities": {
      "get": {
