    "/usage": {
      "get": {
        "operationId": "getUsage",
        "summary": "Get account API usage",
        "tags": [
          "Account"
        ],
        "responses": {
          "200": {
            "description": "Shared credit balance and API usage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource unavailable to this account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict or request still running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Job expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Amazon extraction could not be completed; reserved credits released",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate or concurrency limit exceeded; retry after the indicated delay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Extraction or conversion service failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable; retry after the indicated delay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Customer API key created in /dashboard/api-keys. Never place keys in query strings."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      },
      "JobResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "failed",
              "expired"
            ]
          },
          "jobId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "statusUrl": {
            "type": "string"
          },
          "resultUrl": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "cache": {
            "type": "object",
            "properties": {
              "hit": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "billing": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "status"
        ]
      },
      "MediaResponse": {
        "type": "object",
        "properties": {
          "status": {
            "const": "completed"
          },
          "jobId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "requestId": {
            "type": "string"
          },
          "cache": {
            "type": "object",
            "additionalProperties": true
          },
          "billing": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "$ref": "#/components/schemas/ProductMedia"
          }
        },
        "required": [
          "status",
          "data"
        ]
      },
      "ProductMedia": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "asin": {
                "type": "string"
              },
              "marketplace": {
                "type": "string"
              },
              "canonicalUrl": {
                "type": "string"
              },
              "fetchedAt": {
                "type": "string",
                "format": "date-time"
              },
              "parserVersion": {
                "type": "string"
              },
              "renderMode": {
                "type": "string",
                "enum": [
                  "auto",
                  "static",
                  "interactive"
                ],
                "default": "auto"
              }
            },
            "additionalProperties": true
          },
          "product": {
            "type": "object",
            "properties": {
              "asin": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "media": {
            "type": "object",
            "properties": {
              "productImages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "variantImages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "productVideos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "relatedVideos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "customerReviewVideos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "creatorVideos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "allVideos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          },
          "counts": {
            "type": "object",
            "additionalProperties": true
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "source",
          "product",
          "media",
          "counts",
          "warnings"
        ]
      },
      "ConversionResponse": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source": {
            "type": "string"
          },
          "cache": {
            "type": "object",
            "properties": {
              "hit": {
                "type": "boolean"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "requestId": {
            "type": "string"
          },
          "billing": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "url"
        ]
      },
      "UsageResponse": {
        "type": "object",
        "description": "Customer credit balance, current usage period, API request totals, and configured limits.",
        "additionalProperties": true
      }
    }
  }
}
